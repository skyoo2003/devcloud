{
  "openapi": "3.0.0",
  "info": {
    "title": "Google Cloud Secret Manager",
    "version": "v1",
    "description": "Google Cloud Secret Manager API v1",
    "x-service-id": "gcpsecrets",
    "x-provider": "gcp",
    "x-protocol": "rest-json"
  },
  "paths": {
    "/v1/projects/{project}/secrets": {
      "get": {
        "operationId": "ListSecrets",
        "description": "Lists secrets in a given project",
        "parameters": [
          {
            "name": "project",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of secrets"
          }
        }
      },
      "post": {
        "operationId": "CreateSecret",
        "description": "Creates a new secret",
        "parameters": [
          {
            "name": "project",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "secretId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Created secret"
          }
        }
      }
    },
    "/v1/projects/{project}/secrets/{secret}": {
      "get": {
        "operationId": "GetSecret",
        "description": "Gets secret metadata",
        "parameters": [
          {
            "name": "project",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "secret",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Secret metadata"
          }
        }
      },
      "delete": {
        "operationId": "DeleteSecret",
        "description": "Deletes a secret",
        "parameters": [
          {
            "name": "project",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "secret",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Secret deleted"
          }
        }
      }
    },
    "/v1/projects/{project}/secrets/{secret}:addVersion": {
      "post": {
        "operationId": "AddSecretVersion",
        "description": "Creates a new SecretVersion containing secret data and adds it to an existing Secret",
        "parameters": [
          {
            "name": "project",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "secret",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Secret version created"
          }
        }
      }
    },
    "/v1/projects/{project}/secrets/{secret}/versions": {
      "get": {
        "operationId": "ListSecretVersions",
        "description": "Lists secret versions",
        "parameters": [
          {
            "name": "project",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "secret",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of secret versions"
          }
        }
      }
    },
    "/v1/projects/{project}/secrets/{secret}/versions/{version}:access": {
      "get": {
        "operationId": "AccessSecretVersion",
        "description": "Accesses a SecretVersion. This call returns the secret data.",
        "parameters": [
          {
            "name": "project",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "secret",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "version",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Secret payload"
          }
        }
      }
    },
    "/v1/projects/{project}/secrets/{secret}/versions/{version}:destroy": {
      "post": {
        "operationId": "DestroySecretVersion",
        "description": "Destroys a SecretVersion.",
        "parameters": [
          {
            "name": "project",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "secret",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "version",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Destroyed version"
          }
        }
      }
    }
  }
}
